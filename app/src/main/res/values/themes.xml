<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch window before Compose draws: photo-print paper, transparent system bars. -->
    <style name="Base.Theme.Pherry" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pherry_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Pherry" parent="Base.Theme.Pherry" />
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Canonical Pherry logo: launcher background gradient + launcher foreground glyph,
  combined into one self-contained drawable for in-app use (wordmark, onboarding,
  settings). Keep in sync with ic_launcher_background.xml + ic_launcher_foreground.xml.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- gradient background (full square; callers clip the corners) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF13B5A6"
                android:endColor="#FF0B7E72" />
        </aapt:attr>
    </path>
    <!-- water / wave (the "ferry" crosses) -->
    <path
        android:pathData="M32,75 C38,69 44,81 50,75 C56,69 62,81 68,75 C71,72 74,73 76,75"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeAlpha="0.92" />
    <!-- forward chevrons (motion / send) -->
    <path
        android:pathData="M41,33 L57,49 L41,65"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M57,33 L73,49 L57,65"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeAlpha="0.5" />
</vector>

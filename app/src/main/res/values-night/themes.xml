<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Launch window before Compose draws: darkroom ground, transparent system bars. -->
    <style name="Base.Theme.Pherry" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/pherry_darkroom</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
